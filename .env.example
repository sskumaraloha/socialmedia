# Copy to .env and adjust before running `docker compose up`.
# Nothing here is a real secret - replace before deploying anywhere but a laptop.

# ---- Common ----
SPRING_PROFILES_ACTIVE=docker
COMPOSE_PROJECT_NAME=socialmedia

# ---- PostgreSQL (shared instance, one database per service) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_MULTIPLE_DATABASES=auth_db,user_db,chat_db,media_db,notification_db,payment_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---- MongoDB (shared instance, one database per service) ----
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
MONGO_USERNAME=root
MONGO_PASSWORD=example

# ---- Redis ----
REDIS_PASSWORD=redis

# ---- Kafka (KRaft mode, single broker) ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- OpenSearch ----
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ---- MinIO (S3-compatible object storage for media-service) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MEDIA_S3_BUCKET=media
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# Leave blank to serve media via S3 presigned URLs; set to front the bucket with a CDN instead.
MEDIA_CDN_BASE_URL=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- Auth / JWT ----
JWT_SECRET=replace-with-a-long-random-base64-secret-before-any-real-use
OAUTH2_AUTHORIZED_REDIRECT_URI=http://localhost:3000/oauth2/callback

# ---- Auth / OAuth2 (Google + GitHub login) ----
# Leaving these as placeholders is fine for local dev - oauth2Login just won't
# successfully authenticate against the real providers until you set real values.
GOOGLE_OAUTH2_CLIENT_ID=changeme-google-client-id
GOOGLE_OAUTH2_CLIENT_SECRET=changeme-google-client-secret
GITHUB_OAUTH2_CLIENT_ID=changeme-github-client-id
GITHUB_OAUTH2_CLIENT_SECRET=changeme-github-client-secret

# ---- Auth / Keycloak (alternative to the above - activate with SPRING_PROFILES_ACTIVE=keycloak,docker) ----
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/socialmedia

# ---- Notification (Firebase Cloud Messaging) ----
# Mount a real service-account JSON at this path via a docker-compose volume to enable push.
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-service-account.json

# ---- Payment (Stripe) ----
STRIPE_API_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# ---- Observability ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
